POSTGRES_PASSWORD=replace-with-a-local-development-password
DATABASE_URL=postgresql+psycopg://karaokewebapp:replace-with-a-local-development-password@localhost:5433/karaokewebapp
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
CORS_ORIGINS=http://localhost:4200,http://localhost:8100
ACCESS_TOKEN_MINUTES=60
APP_BASE_URL=http://localhost:4200
